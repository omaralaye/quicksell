{
  "expo": {
    "name": "NearSwap",
    "slug": "nearswap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-aie.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-aie.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quicksell.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-aie.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.quicksell.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow NearSwap to access your location to show nearby marketplace items and sellers."
        }
      ]
    ],
    "scheme": "nearswap",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af8708c0-4833-494c-adbf-a39a879b0df3"
      }
    }
  }
}
